# 最省事的用法：只设环境变量，不写配置文件。
# 插件会用这三个变量合成一个名为 "env" 的渠道。
LINGER_VISION_API_KEY=sk-your-key-here
LINGER_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LINGER_VISION_MODEL=qwen-vl-max

# 也认这些厂商专用变量（用于配置文件里的 env: 引用，或单独合成渠道）
# DASHSCOPE_API_KEY=sk-xxx        # 阿里云百炼
# OPENAI_API_KEY=sk-xxx           # OpenAI
# ZHIPU_API_KEY=xxx               # 智谱 GLM
# SILICONFLOW_API_KEY=sk-xxx      # 硅基流动

# 可选：临时切换渠道 / 关掉故障转移 / 指定配置文件
# LINGER_VISION_CHANNEL=openai
# LINGER_VISION_FAILOVER=0
# LINGER_IMAGE_CONFIG=/abs/path/to/config.json
